{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.schema.json",
  "title": "Scenario: which personas, how much load, for how long, and how to judge the result",
  "x-perfkit": {
    "folder": "scenarios",
    "group": "description",
    "references": [
      { "path": "personas[].id", "kind": "persona" },
      { "path": "collectors[]", "kind": "collector" },
      { "path": "reporters[]", "kind": "reporter" }
    ]
  },
  "type": "object",
  "required": ["kind", "id", "version", "personas", "load"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "scenario" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "description": { "$ref": "common.schema.json#/$defs/description" },
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "weight"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "weight": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "load": {
      "type": "object",
      "required": ["type", "stages"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ramping-arrival-rate", "constant-arrival-rate"] },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["durationS", "targetRps"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "durationS": { "type": "number", "exclusiveMinimum": 0 },
              "targetRps": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "collectors": { "$ref": "common.schema.json#/$defs/idList" },
    "reporters": { "$ref": "common.schema.json#/$defs/idList" },
    "thresholds": { "type": "object", "additionalProperties": { "type": "string" } },
    "compare": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "description": "Metrics that gate the run: a metric of every measurement (p95) or NAME:METRIC of one (server_rss:slope).",
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "window": { "type": "integer", "minimum": 1 },
        "maxRegressionPct": { "$ref": "common.schema.json#/$defs/percent" }
      }
    }
  }
}
