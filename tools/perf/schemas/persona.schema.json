{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "persona.schema.json",
  "title": "Persona: one kind of user, its sign-in and the requests it makes",
  "x-perfkit": {
    "folder": "personas",
    "group": "description",
    "references": [
      { "path": "fixtures[]", "kind": "fixture" },
      { "path": "steps[].body", "kind": "fixture", "withFile": true }
    ]
  },
  "type": "object",
  "required": ["kind", "id", "version", "auth", "steps"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "persona" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "description": { "$ref": "common.schema.json#/$defs/description" },
    "fixtures": { "$ref": "common.schema.json#/$defs/idList" },
    "auth": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["none", "mission-owner", "link-pin", "admin-token"] },
        "role": { "enum": ["edit", "view"] }
      }
    },
    "thinkTimeS": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 }
      }
    },
    "setup": { "type": "object", "description": "Data the orchestrator creates before the run, for example links with PINs." },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "checks": { "type": "array", "items": { "type": "object", "required": ["name"] } }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["name", "weight", "method", "path"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/id" },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "pattern": "^/" },
        "body": {
          "type": ["string", "object"],
          "pattern": "^[a-z0-9][a-z0-9-]*:[A-Za-z0-9_][A-Za-z0-9_./-]*$",
          "description": "Inline JSON, or FIXTURE:FILE from a fixture."
        },
        "expect": { "type": "integer", "minimum": 100, "maximum": 599 },
        "maxPerLink": { "type": "integer", "minimum": 1 },
        "poll": {
          "type": "object",
          "required": ["path", "untilField", "timeoutS"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "pattern": "^/" },
            "untilField": { "type": "string", "minLength": 1 },
            "timeoutS": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    }
  }
}
