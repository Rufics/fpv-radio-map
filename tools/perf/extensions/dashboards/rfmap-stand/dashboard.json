{
  "uid": "rfmap-perf-stand",
  "title": "rfmap perf stand",
  "tags": [
    "rfmap-perf"
  ],
  "timezone": "utc",
  "schemaVersion": 41,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "Run phases",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "rgba(255, 152, 48, 0.6)",
        "target": {
          "type": "tags",
          "tags": [
            "rfmap-perf"
          ],
          "matchAny": true,
          "limit": 200
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Server CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "rfmap-perf-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "rfmap-perf-prometheus"
          },
          "expr": "rate(rfmap_process_cpu_seconds_total[15s])",
          "legendFormat": "server_cpu"
        }
      ]
    },
    {
