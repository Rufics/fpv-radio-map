{
  "version": 8,
  "name": "FPV Radio Map — dark",
  "metadata": {
    "rfmap:generated-by": "rfmap/tiles-builder",
    "rfmap:note": "Template. {{BASE_URL}} is replaced by --public-base-url; sources whose file was not built are removed."
  },
  "glyphs": "{{BASE_URL}}/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": { "type": "vector", "url": "pmtiles://{{BASE_URL}}/basemap.pmtiles" },
    "satellite": { "type": "raster", "url": "pmtiles://{{BASE_URL}}/satellite.pmtiles", "tileSize": 256 },
    "hillshade": { "type": "raster", "url": "pmtiles://{{BASE_URL}}/hillshade.pmtiles", "tileSize": 256 },
    "contours": { "type": "vector", "url": "pmtiles://{{BASE_URL}}/contours.pmtiles" }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#0B0F14" } },

    { "id": "satellite", "type": "raster", "source": "satellite",
      "layout": { "visibility": "none" },
      "paint": { "raster-opacity": 1, "raster-brightness-max": 0.85, "raster-saturation": -0.2 } },

    { "id": "landcover-wood", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "wood"],
      "paint": { "fill-color": "#0F1916", "fill-opacity": 0.9 } },
    { "id": "landcover-grass", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["grass", "farmland", "wetland"], true, false],
      "paint": { "fill-color": "#0E1517", "fill-opacity": 0.8 } },
    { "id": "landcover-ice-sand", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["ice", "sand", "rock"], true, false],
      "paint": { "fill-color": "#151A20", "fill-opacity": 0.8 } },
    { "id": "landuse-residential", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["match", ["get", "class"], ["residential", "suburb", "neighbourhood"], true, false],
      "paint": { "fill-color": "#11161D" } },
    { "id": "landuse-other", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["match", ["get", "class"], ["industrial", "commercial", "retail", "railway", "military", "quarry"], true, false],
      "paint": { "fill-color": "#13171E" } },
    { "id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park",
      "paint": { "fill-color": "#0E1814", "fill-opacity": 0.8 } },

    { "id": "hillshade", "type": "raster", "source": "hillshade",
      "paint": { "raster-opacity": ["interpolate", ["linear"], ["zoom"], 6, 0.9, 14, 0.6], "raster-fade-duration": 0 } },

    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": { "fill-color": "#1E4B66" } },
    { "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "layout": { "line-cap": "round" },
      "paint": { "line-color": "#1E4B66",
                 "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 8, 0.5, 14, ["match", ["get", "class"], ["river", "canal"], 3, 1.2], 18, ["match", ["get", "class"], ["river", "canal"], 12, 3]] } },

    { "id": "contour", "type": "line", "source": "contours", "source-layer": "contours", "minzoom": 12,
      "paint": { "line-color": "#3A4350", "line-width": 0.6, "line-opacity": 0.7 } },
    { "id": "contour-index", "type": "line", "source": "contours", "source-layer": "contours_index",
      "paint": { "line-color": "#4D5766", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.6, 15, 1.2], "line-opacity": 0.8 } },

    { "id": "aeroway-area", "type": "fill", "source": "openmaptiles", "source-layer": "aeroway",
      "filter": ["==", ["geometry-type"], "Polygon"], "minzoom": 10,
      "paint": { "fill-color": "#161B22" } },
    { "id": "aeroway-runway", "type": "line", "source": "openmaptiles", "source-layer": "aeroway",
      "filter": ["all", ["==", ["geometry-type"], "LineString"], ["match", ["get", "class"], ["runway", "taxiway"], true, false]], "minzoom": 10,
      "paint": { "line-color": "#2B323C", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 10, 1, 16, ["match", ["get", "class"], "runway", 30, 8]] } },

    { "id": "building", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 13,
      "paint": { "fill-color": "#161C24", "fill-outline-color": "#1F2630", "fill-opacity": ["interpolate", ["linear"], ["zoom"], 13, 0, 14.5, 1] } },

    { "id": "road-tunnel", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["all", ["==", ["get", "brunnel"], "tunnel"], ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"], true, false]],
      "layout": { "line-join": "round" },
      "paint": { "line-color": "#262C35", "line-dasharray": [1, 1], "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 10, 0.5, 18, 8] } },
    { "id": "road-path", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 13,
      "filter": ["match", ["get", "class"], ["path", "track"], true, false],
      "paint": { "line-color": "#2B323B", "line-dasharray": [2, 1.5], "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.5, 18, 2] } },
    { "id": "road-minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["all", ["!=", ["get", "brunnel"], "tunnel"], ["match", ["get", "class"], ["minor", "service"], true, false]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#333B46", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 12, 0.4, 14, 1.2, 18, 10] } },
    { "id": "road-secondary-tertiary", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["all", ["!=", ["get", "brunnel"], "tunnel"], ["match", ["get", "class"], ["secondary", "tertiary"], true, false]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#333B46", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 8, 0.4, 14, 2.5, 18, 16] } },
    { "id": "road-primary-trunk", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["all", ["!=", ["get", "brunnel"], "tunnel"], ["match", ["get", "class"], ["primary", "trunk"], true, false]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#3C4551", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 5, 0.4, 14, 3.5, 18, 20] } },
    { "id": "road-motorway", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["all", ["!=", ["get", "brunnel"], "tunnel"], ["==", ["get", "class"], "motorway"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#46505D", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 4, 0.5, 14, 4, 18, 24] } },
    { "id": "railway", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 9,
      "filter": ["all", ["==", ["get", "class"], "rail"], ["!=", ["get", "brunnel"], "tunnel"]],
      "paint": { "line-color": "#3A414B", "line-dasharray": [3, 2], "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.5, 16, 2] } },

    { "id": "boundary-country", "type": "line", "source": "openmaptiles", "source-layer": "boundary",
      "filter": ["all", ["<=", ["get", "admin_level"], 2], ["!=", ["get", "maritime"], 1]],
      "paint": { "line-color": "#5A6372", "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.6, 10, 2] } },
    { "id": "boundary-region", "type": "line", "source": "openmaptiles", "source-layer": "boundary",
      "filter": ["all", [">", ["get", "admin_level"], 2], ["<=", ["get", "admin_level"], 4], ["!=", ["get", "maritime"], 1]],
      "paint": { "line-color": "#454D59", "line-dasharray": [3, 2], "line-width": 0.8 } },

    { "id": "contour-label", "type": "symbol", "source": "contours", "source-layer": "contours_index", "minzoom": 13,
      "layout": { "symbol-placement": "line", "text-field": ["concat", ["to-string", ["get", "ele"]], " m"],
                  "text-font": ["Noto Sans Regular"], "text-size": 10, "symbol-spacing": 350 },
      "paint": { "text-color": "#7D8794", "text-halo-color": "#0B0F14", "text-halo-width": 1.2 } },
    { "id": "waterway-label", "type": "symbol", "source": "openmaptiles", "source-layer": "waterway_name", "minzoom": 12,
      "layout": { "symbol-placement": "line", "text-field": ["get", "name"], "text-font": ["Noto Sans Italic"], "text-size": 11 },
      "paint": { "text-color": "#6F9FBC", "text-halo-color": "#0B0F14", "text-halo-width": 1.2 } },
    { "id": "water-label", "type": "symbol", "source": "openmaptiles", "source-layer": "water_name",
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Italic"], "text-size": 12, "text-max-width": 8 },
      "paint": { "text-color": "#6F9FBC", "text-halo-color": "#0B0F14", "text-halo-width": 1.2 } },
    { "id": "road-label", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name", "minzoom": 13,
      "layout": { "symbol-placement": "line", "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"],
                  "text-size": ["interpolate", ["linear"], ["zoom"], 13, 10, 18, 13] },
      "paint": { "text-color": "#A3ACB7", "text-halo-color": "#0B0F14", "text-halo-width": 1.4 } },
    { "id": "peak-label", "type": "symbol", "source": "openmaptiles", "source-layer": "mountain_peak", "minzoom": 11,
      "layout": { "text-field": ["concat", "▲ ", ["coalesce", ["get", "name"], ""], "\n", ["to-string", ["coalesce", ["get", "ele"], ""]], " m"],
                  "text-font": ["Noto Sans Regular"], "text-size": 10, "text-max-width": 9 },
      "paint": { "text-color": "#B4BCC6", "text-halo-color": "#0B0F14", "text-halo-width": 1.2 } },
    { "id": "aerodrome-label", "type": "symbol", "source": "openmaptiles", "source-layer": "aerodrome_label", "minzoom": 9,
      "layout": { "text-field": ["concat", "✈ ", ["get", "name"]], "text-font": ["Noto Sans Medium"], "text-size": 11, "text-max-width": 9 },
      "paint": { "text-color": "#C9D1D9", "text-halo-color": "#0B0F14", "text-halo-width": 1.4 } },
    { "id": "place-minor", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
      "filter": ["match", ["get", "class"], ["village", "hamlet", "suburb", "neighbourhood", "quarter", "isolated_dwelling"], true, false],
      "minzoom": 11,
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"],
                  "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 16, 14], "text-max-width": 8 },
      "paint": { "text-color": "#AEB7C1", "text-halo-color": "#0B0F14", "text-halo-width": 1.4 } },
    { "id": "place-town", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
      "filter": ["==", ["get", "class"], "town"], "minzoom": 8,
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Medium"],
                  "text-size": ["interpolate", ["linear"], ["zoom"], 8, 11, 14, 15], "text-max-width": 8 },
      "paint": { "text-color": "#C9D1D9", "text-halo-color": "#0B0F14", "text-halo-width": 1.5 } },
    { "id": "place-city", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
      "filter": ["==", ["get", "class"], "city"],
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Medium"],
                  "text-size": ["interpolate", ["linear"], ["zoom"], 4, 11, 12, 18], "text-max-width": 8 },
      "paint": { "text-color": "#D8DEE5", "text-halo-color": "#0B0F14", "text-halo-width": 1.6 } },
    { "id": "place-country", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
      "filter": ["==", ["get", "class"], "country"], "maxzoom": 9,
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Medium"], "text-size": 13,
                  "text-transform": "uppercase", "text-letter-spacing": 0.1, "text-max-width": 8 },
      "paint": { "text-color": "#B8C0CA", "text-halo-color": "#0B0F14", "text-halo-width": 1.6 } }
  ]
}
