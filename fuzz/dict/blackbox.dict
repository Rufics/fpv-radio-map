# Betaflight Blackbox log tokens: the header lines the decoder reads and the frame markers.
product="H Product:Blackbox flight data recorder by Nicholas Sherlock\x0a"
data_version="H Data version:2\x0a"
i_interval="H I interval:"
p_interval="H P interval:"
p_ratio="H P ratio:"
field_i_name="H Field I name:"
field_i_signed="H Field I signed:"
field_i_predictor="H Field I predictor:"
field_i_encoding="H Field I encoding:"
field_p_predictor="H Field P predictor:"
field_p_encoding="H Field P encoding:"
field_g_name="H Field G name:"
field_h_name="H Field H name:"
field_s_name="H Field S name:"
firmware_revision="H Firmware revision:Betaflight 4.5.1 (77d01ba3b) STM32F7X2\x0a"
firmware_old="H Firmware revision:Betaflight 3.5.7 (5d8a8c4b4) OMNIBUSF4\x0a"
firmware_new="H Firmware revision:Betaflight 2025.12.2 (a1b2c3d4e) STM32H743\x0a"
vbatref="H vbatref:"
vbatscale="H vbat_scale:"
minthrottle="H minthrottle:"
current_meter="H currentSensor:"
