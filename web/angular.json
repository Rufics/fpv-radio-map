{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "ui-kit": {
      "projectType": "library",
      "root": "projects/ui-kit",
      "sourceRoot": "projects/ui-kit/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ui-kit/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ui-kit/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ui-kit/tsconfig.spec.json"
          }
        }
      }
    },
    "fpv-app": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/fpv-app",
      "sourceRoot": "projects/fpv-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/fpv-app/src/main.ts",
            "tsConfig": "projects/fpv-app/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/fpv-app/public"
              },
              {
                "glob": "maplibre-gl-worker.mjs",
                "input": "node_modules/maplibre-gl/dist",
                "output": "maplibre"
              }
            ],
            "styles": [
              "projects/ui-kit/styles/rfmap-ui-kit.css",
              "node_modules/maplibre-gl/dist/maplibre-gl.css",
              "projects/fpv-app/src/styles.css"
            ],
            "allowedCommonJsDependencies": [
              "ajv",
              "ajv-formats",
              "fast-deep-equal",
              "json-schema-traverse",
              "fast-uri",
              "require-from-string",
              "maplibre-gl"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2.5MB",
                  "maximumError": "4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kB",
                  "maximumError": "20kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/fpv-app/src/environments/environment.ts",
                  "with": "projects/fpv-app/src/environments/environment.development.ts"
                },
                {
                  "replace": "projects/fpv-app/src/app/mock-entry.ts",
                  "with": "projects/fpv-app/src/app/mock-entry.mock.ts"
                }
              ]
            },
            "mock": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2.5MB",
                  "maximumError": "4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kB",
                  "maximumError": "20kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "projects/fpv-app/src/environments/environment.ts",
                  "with": "projects/fpv-app/src/environments/environment.mock.ts"
                },
                {
                  "replace": "projects/fpv-app/src/app/mock-entry.ts",
                  "with": "projects/fpv-app/src/app/mock-entry.mock.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "fpv-app:build:production"
            },
            "development": {
              "buildTarget": "fpv-app:build:development"
            },
            "mock": {
              "buildTarget": "fpv-app:build:mock"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/fpv-app/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
