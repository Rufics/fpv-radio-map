{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Body shadow options",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "lossDb": { "type": "number", "minimum": 0, "maximum": 40, "default": 0, "description": "Measured body loss at the ground end, dB" },
    "source": { "type": "string", "maxLength": 200, "default": "", "description": "Where the number comes from, shown in the breakdown" },
    "uncertaintyDb": { "type": "number", "minimum": 0, "maximum": 20, "default": 0, "description": "± spread of the measurement, dB" }
  }
}
