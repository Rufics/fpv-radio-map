{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rfmap.local/schemas/mission.schema.json",
  "title": "Mission",
  "type": "object",
  "required": [
    "schema",
    "name",
    "time",
    "pilot",
    "waypoints",
    "evaluate"
  ],
  "properties": {
    "schema": {
      "const": "mission/v1"
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "time": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "now",
            "planned"
          ]
        },
        "utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "altitudeRef": {
      "enum": [
        "launch",
        "agl"
      ],
      "default": "agl",
      "description": "What waypoint heights are measured from. launch: altM above the ground at the pilot, a barometric altitude from take-off; the drone flies a straight line in altitude between waypoints and does not follow the terrain. agl: aglM above the ground under the drone, which follows the terrain between waypoints. Without the field a mission is agl."
    },
    "pilot": {
      "$ref": "#/$defs/pilot"
    },
    "waypoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/waypoint"
      },
      "minItems": 1,
      "description": "Route in flight order; the last point is the target. At most 1000 waypoints; the server also bounds the work of one route calculation (calc.maxRouteSamples).",
      "maxItems": 1000
    },
    "returnToPilot": {
      "type": "boolean",
      "default": true
    },
    "flightMode": {
      "enum": [
        "manual",
        "autonomous"
      ],
      "default": "manual",
      "description": "manual: the pilot flies the route over the control link, so losing it stops the mission (the failsafe takes over). autonomous: the route is uploaded to the flight controller before take-off and the autopilot flies it on its own; the radio links are optional and a link below its margin is a warning (the pilot cannot take over there), not a blocker. Without the field a mission is manual."
    },
    "links": {
      "type": "object",
      "properties": {
        "control": {
          "$ref": "#/$defs/linkSetup"
        },
        "video": {
          "$ref": "#/$defs/linkSetup"
        }
      },
      "description": "Radio setups for the links in evaluate. Optional: a mission that evaluates no link (evaluate none) needs none."
    },
    "evaluate": {
      "enum": [
        "both",
        "control",
        "video",
        "none"
      ],
      "description": "Links the calculation evaluates. none: no radio link at all, for an autonomous route flown without one; the route is still checked for terrain, energy and the airframe."
    },
    "drone": {
      "type": "string",
      "description": "Drone profile id",
      "maxLength": 64
    },
    "battery": {
      "type": "string",
      "description": "Battery id",
      "maxLength": 64
    },
    "modules": {
      "type": "object",
      "description": "Opt-in modules for this mission, with their options.",
      "additionalProperties": {
        "type": "object"
      },
      "maxProperties": 64
    },
    "coverage": {
      "type": "object",
      "properties": {
        "radiusM": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 50000
        },
        "cellM": {
          "type": "number",
          "minimum": 10
        },
        "droneAglM": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": [
        "lat",
        "lon",
        "aglM"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "aglM": {
          "type": "number",
          "minimum": 0,
          "description": "Height above ground; MSL is computed from the DEM.",
          "maximum": 100000
        },
        "label": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "pilot": {
      "type": "object",
      "required": [
        "lat",
        "lon",
        "aglM"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "aglM": {
          "type": "number",
          "minimum": 0,
          "description": "Antenna height above the ground at the pilot, in both altitude references.",
          "maximum": 100000
        },
        "label": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "waypoint": {
      "type": "object",
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "aglM": {
          "type": "number",
          "minimum": 0,
          "description": "Height above the ground under the drone (altitudeRef agl); MSL is computed from the DEM.",
          "maximum": 100000
        },
        "altM": {
          "type": "number",
          "minimum": -2000,
          "maximum": 10000,
          "description": "Height above the ground at the pilot (altitudeRef launch), as a barometric altimeter zeroed at take-off reads it. Negative is below the launch point."
        },
        "heightSource": {
          "enum": [
            "auto",
            "manual"
          ],
          "description": "Who sets the height. manual: the height field of the mission's altitudeRef (aglM or altM) is the user's and is never changed. auto: the server sets it before the calculation (route.prepare, fpv.altitude) and a stored value is only the last one it set. Without the field a waypoint with a height is manual and one without is auto."
        },
        "label": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "linkSetup": {
      "type": "object",
      "required": [
        "radio",
        "txPowerDbm",
        "groundAntenna",
        "airAntenna",
        "requiredMarginDb"
      ],
      "properties": {
        "radio": {
          "type": "string",
          "maxLength": 64
        },
        "txPowerDbm": {
          "type": "number",
          "minimum": -60,
          "maximum": 70
        },
        "groundAntenna": {
          "type": "string",
          "maxLength": 64
        },
        "airAntenna": {
          "type": "string",
          "maxLength": 64
        },
        "requiredMarginDb": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "altitudeRef"
        ],
        "properties": {
          "altitudeRef": {
            "const": "launch"
          }
        }
      },
      "then": {
        "properties": {
          "waypoints": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "altM": {
                  "type": "number"
                }
              },
              "if": {
                "required": [
                  "heightSource"
                ],
                "properties": {
                  "heightSource": {
                    "const": "manual"
                  }
                }
              },
              "then": {
                "properties": {
                  "altM": {
                    "type": "number"
                  }
                },
                "required": [
                  "altM"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "waypoints": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "aglM": {
                  "type": "number"
                }
              },
              "if": {
                "required": [
                  "heightSource"
                ],
                "properties": {
                  "heightSource": {
                    "const": "manual"
                  }
                }
              },
              "then": {
                "properties": {
                  "aglM": {
                    "type": "number"
                  }
                },
                "required": [
                  "aglM"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
