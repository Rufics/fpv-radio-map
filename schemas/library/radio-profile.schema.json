{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rfmap.local/schemas/library/radio-profile.schema.json",
  "title": "Radio link profile (control or video)",
  "description": "One operating mode of a radio system, for example 'ELRS 433 MHz, 50 Hz' or 'Digital video 915 MHz, 20 MHz'. Values come from datasheets or measurements and are never hard-coded in the program.",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "verified",
    "kind",
    "frequencyHz",
    "txPowerDbm",
    "sensitivity",
    "latencyMs"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "vendor": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bumped on every edit; results record the version they used."
    },
    "verified": {
      "type": "boolean",
      "description": "Set by an admin after checking sources. User libraries (later) are never verified."
    },
    "notes": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "control",
        "video-digital",
        "video-analog"
      ]
    },
    "frequencyHz": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "txPowerDbm": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 1,
      "description": "Selectable output power steps."
    },
    "sensitivity": {
      "$ref": "common.schema.json#/$defs/sensitivity"
    },
    "latencyMs": {
      "type": "object",
      "required": [
        "typical"
      ],
      "properties": {
        "typical": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "source": {
          "$ref": "common.schema.json#/$defs/source"
        }
      }
    },
    "analogGrades": {
      "description": "Analog video only: picture degrades gradually. Each grade is the SNR above the thermal floor needed for that picture quality.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "requiredSnrDb"
        ],
        "properties": {
          "label": {
            "enum": [
              "clear",
              "noisy",
              "lost"
            ]
          },
          "requiredSnrDb": {
            "type": "number"
          }
        }
      }
    },
    "extraNoiseDb": {
      "type": "number",
      "minimum": 0,
      "description": "Additional noise the system adds (for example analog video receivers), added to the noise figure."
    }
  },
  "if": {
    "properties": {
      "kind": {
        "const": "video-analog"
      }
    }
  },
  "then": {
    "required": [
      "analogGrades"
    ],
    "properties": {
      "analogGrades": {
        "type": "array",
        "minItems": 1
      }
    }
  },
  "additionalProperties": false
}
