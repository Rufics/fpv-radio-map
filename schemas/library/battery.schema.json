{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rfmap.local/schemas/library/battery.schema.json",
  "title": "Battery pack",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "verified",
    "chemistry",
    "cellsSeries",
    "capacityAh",
    "nominalCellVoltage",
    "usableFraction",
    "source"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "vendor": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bumped on every edit; results record the version they used."
    },
    "verified": {
      "type": "boolean",
      "description": "Set by an admin after checking sources. User libraries (later) are never verified."
    },
    "notes": {
      "type": "string"
    },
    "chemistry": {
      "enum": [
        "lipo",
        "li-ion",
        "lihv"
      ]
    },
    "cellsSeries": {
      "type": "integer",
      "minimum": 1
    },
    "capacityAh": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nominalCellVoltage": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "usableFraction": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "description": "Share of nominal energy the pilot plans to use; the rest is the reserve."
    },
    "temperatureDerating": {
      "description": "Measured capacity factor by cell temperature. Values between points are interpolated linearly and the result says so.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "celsius",
          "factor"
        ],
        "properties": {
          "celsius": {
            "type": "number"
          },
          "factor": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1.2
          }
        }
      }
    },
    "source": {
      "$ref": "common.schema.json#/$defs/source"
    }
  },
  "additionalProperties": false
}
