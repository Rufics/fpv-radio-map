# Copy to deploy/.env and fill in. Never commit .env.
# Letters and digits only, it goes into a database URL: openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -base64 33
RFMAP_ADMIN_TOKEN=
# Contents of your owner .pub file (rfmod keygen --out owner). Empty = development key.
RFMAP_OWNER_PUBKEY=
# tools/tiles-builder output directory: dem.cog.tif, landcover.cog.tif, *.pmtiles, fonts/, manifest.json
RFMAP_TILES_DIR=/srv/rfmap/tiles
# The DEM provider's stated vertical error and where it is stated.
RFMAP_DEM_STATED_ERROR_M=
RFMAP_DEM_STATED_ERROR_SOURCE=
RFMAP_HTTP_PORT=8088
# The model rfmap-server asks Open-Meteo for, and the model directories the sync service
# downloads. With dwd_icon, keep dwd_icon_global_eps_native in the sync list (see docs/admin/deploy.md).
OPEN_METEO_MODELS=dwd_icon
OPEN_METEO_SYNC_MODELS=dwd_icon,dwd_icon_global_eps_native
